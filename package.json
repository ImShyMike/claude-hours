{
  "name": "claude-hours",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "TZ=America/New_York vitest --run && bun test scripts",
    "test:unit": "TZ=America/New_York vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.5.11",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26",
    "bits-ui": "^2.20.2",
    "chart.js": "^4.6.1",
    "chartjs-chart-matrix": "^3.1.0",
    "cn": "~0.5.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn-svelte": "^1.7.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
