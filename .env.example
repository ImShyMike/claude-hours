# matches the docker-compose.yml at the repo root
DATABASE_URL=postgres://claude_hours:claude_hours@localhost:5434/claude_hours

# register an app at https://auth.hackclub.com/developer/apps with the
# redirect uri http://localhost:5173/auth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# comma separated, matched against verified Hack Club Auth emails
ADMIN_EMAILS=you@hackclub.com

# only for pointing at a staging Hack Club Auth, https://auth.hackclub.com when unset
# HCA_ISSUER=https://auth.hackclub.com

# Deployed (bun ./build) only. The origin comes from the Host header, with
# https unless PROTOCOL_HEADER names a header that says otherwise
# PORT=3000
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# The mod sends at most 256 KB a request, under the default 512K, but the
# hub takes up to 4 MB (scripts/import.ts sends that much, gzipped)
# BODY_SIZE_LIMIT=4M
